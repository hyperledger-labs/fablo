{
  "$schema": "https://github.com/hyperledger-labs/fablo/releases/download/1.2.0/schema.json",
  "global": {
    "fabricVersion": "2.5.0",
    "tls": false,
    "provider": "fabric-x"
  },
  "orgs": [
    {
      "organization": {
        "name": "Org1",
        "domain": "org1.example.com",
        "mspName": "Org1MSP"
      },
      "ca": {
        "prefix": "ca",
        "db": "sqlite"
      }
    },
    {
      "organization": {
        "name": "Org2",
        "domain": "org2.example.com",
        "mspName": "Org2MSP"
      },
      "ca": {
        "prefix": "ca",
        "db": "sqlite"
      }
    }
  ],
  "channels": [
    {
      "name": "mychannel",
      "orgs": [
        {
          "name": "Org1",
          "peers": []
        },
        {
          "name": "Org2",
          "peers": []
        }
      ]
    }
  ],
  "namespaces": [
    {
      "name": "mynamespace",
      "orgs": [
        "Org1",
        "Org2"
      ]
    },
    {
      "name": "audit_ns",
      "orgs": [
        "Org1"
      ]
    }
  ]
}
