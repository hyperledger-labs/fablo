{
  "$schema": "https://github.com/hyperledger-labs/fablo/releases/download/2.6.0/schema.json",
  "global": {
    "provider": "fabric-x"
  },
  "orgs": [
    {
      "organization": {
        "name": "Org1",
        "domain": "org1.example.com"
      }
    },
    {
      "organization": {
        "name": "Org2",
        "domain": "org2.example.com"
      }
    }
  ],
  "channels": [
    {
      "name": "mychannel"
    }
  ],
  "namespaces": [
    {
      "name": "mynamespace"
    },
    {
      "name": "audit_ns",
      "orgs": ["Org1"]
    }
  ]
}
