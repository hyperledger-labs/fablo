import "docs_parity.jh" as app
import "lib_docs.jh" as lib

# A bare run must review, not edit. Fix mode is the only path that rewrites
# the generated mirror.
test "an unrecognised mode falls through to check, never fix" {
  mock prompt {
    _ => "{\"status\": \"ok\", \"findings\": \"matches\"}"
  }
  mock def lib.worktree_is_clean() {
    return "ok"
  }
  mock def lib.static_parity_checks() {
    return "ok"
  }
  mock def lib.docs_files_present() {
    return "ok"
  }
  mock def lib.no_drift_recorded() {
    return "ok"
  }
  mock script lib.list_doc_pages() {
    echo "README.md"
  }
  mock script lib.source_of_truth_for() {
    echo "fablo.sh"
  }
  mock script lib.init_report() {
    echo "report"
  }
  mock script lib.append_report() {
    true
  }
  mock script lib.read_report() {
    echo "**Status:** ok"
  }
  mock script lib.sync_fablo_mirror() {
    echo "MIRROR SYNC SHOULD NOT RUN"
  }
  mock script app.log_claude_usage() {
    echo "Claude current session usage is 12%."
  }

  const out = app.main("")
  expect_contain out "ok"
  expect_not_contain out "MIRROR SYNC SHOULD NOT RUN"
}

test "static mode does not require a clean worktree" {
  mock def lib.docs_files_present() {
    return "ok"
  }
  mock def lib.static_parity_checks() {
    return "ok"
  }
  mock script lib.list_doc_pages() {
    echo "README.md"
  }

  const out = app.main("static")
  expect_contain out "Static documentation parity checks passed."
}
