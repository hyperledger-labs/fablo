#!/usr/bin/env jaiph

# Cheap preflight for issue implementation. No agent calls.
#
#   jaiph run .jaiph/readiness.jh
export script has_node = 'command -v node >/dev/null'

export script has_npm = 'command -v npm >/dev/null'

export script has_package_json = 'test -f package.json'

export script has_node_modules = 'test -d node_modules'

export def tools_present() {
  has_node()
  has_npm()
  has_package_json()
  has_node_modules()
}

export def main() {
  tools_present()
}
