import "implement_issue.jh" as app
import "readiness.jh" as ready
import "verification.jh" as verify

# Prompts, git, npm, and filesystem checks are mocked so the suite never
# calls Claude or mutates the tree. What is under test is the orchestration:
# preflight, then implement, then verification, then the snapshot rebuild,
# then the forbidden-path gate.
test "default implements the issue then verifies" {
  mock prompt {
    _ => "implemented"
  }
  mock def ready.tools_present() {
    return "ok"
  }
  mock script app.read_issue() {
    echo "{\"number\":42,\"title\":\"demo issue\"}"
  }
  mock script verify.all() {
    echo "ok"
  }
  mock script verify.snapshots() {
    echo "Docs-only change; skipping the snapshot rebuild."
  }
  mock script verify.no_forbidden_paths() {
    echo "Changed paths pass the policy."
  }

  const out = app.main("issue.json")
  expect_contain out "Implementation complete"
}

test "default fails when the agent edits a forbidden path" {
  mock prompt {
    _ => "implemented"
  }
  mock def ready.tools_present() {
    return "ok"
  }
  mock script app.read_issue() {
    echo "{\"number\":42,\"title\":\"demo issue\"}"
  }
  mock script verify.all() {
    echo "ok"
  }
  mock script verify.snapshots() {
    echo "ok"
  }
  mock script verify.no_forbidden_paths() {
    echo "forbidden (credential file): src/credentials.json" >&2
    exit 1
  }

  const out = app.main("issue.json") allow_failure
  expect_contain out "forbidden"
}

# A hand-written snapshot is the failure mode that reached CI on the first
# real run, so the rebuild must be able to fail the whole run.
test "default fails when the snapshots cannot be regenerated" {
  mock prompt {
    _ => "tried to fix it"
  }
  mock def ready.tools_present() {
    return "ok"
  }
  mock script app.read_issue() {
    echo "{\"number\":42,\"title\":\"demo issue\"}"
  }
  mock script verify.all() {
    echo "ok"
  }
  mock script verify.snapshots() {
    echo "snapshot rebuild failed" >&2
    exit 1
  }
  mock script verify.no_forbidden_paths() {
    echo "Changed paths pass the policy."
  }

  const out = app.main("issue.json") allow_failure
  expect_contain out "snapshot rebuild failed"
}

test "readiness fails when node_modules is missing" {
  mock script ready.has_node() {
    true
  }
  mock script ready.has_npm() {
    true
  }
  mock script ready.has_package_json() {
    true
  }
  mock script ready.has_node_modules() {
    echo "node_modules missing" >&2
    exit 1
  }

  const out = ready.main() allow_failure
  expect_contain out "node_modules"
}
