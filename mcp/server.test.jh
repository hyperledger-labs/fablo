import "server.jh" as server

# The prompt and the Fablo adapter are mocked, so these tests call no agent
# and no Docker. They cover when network_up asks the agent and when it starts
# the network.
test "network_up starts the network after the agent prepares the config" {
  mock prompt {
    _ => "{\"ready\": true, \"summary\": \"Two orgs on channel my-channel1.\"}"
  }
  mock script server.network_dir() {
    printf '/networks/demo'
  }
  mock script server.read_skill() {
    echo "# Fablo skill"
  }
  mock script server.fablo() {
    echo "fablo $*"
  }

  const out = run server.network_up("two organizations with one channel")
  expect_contain out "Two orgs on channel my-channel1."
  expect_contain out "fablo up"
}

test "network_up does not start the network when the agent is not ready" {
  mock prompt {
    _ => "{\"ready\": false, \"summary\": \"fablo-target exists with another topology.\"}"
  }
  mock script server.network_dir() {
    printf '/networks/demo'
  }
  mock script server.read_skill() {
    echo "# Fablo skill"
  }
  mock script server.fablo() {
    echo "fablo $*"
  }

  const out = run server.network_up("three organizations") allow_failure
  expect_contain out "fablo-target exists with another topology."
  expect_not_contain out "fablo up"
}

test "network_up with empty instructions starts the existing config" {
  mock script server.fablo() {
    echo "fablo $*"
  }

  const out = run server.network_up("")
  expect_equal out "fablo up"
}
