
# Arma Shared Configuration for the dynamic devnet.
# Cert paths are absolute inside the Docker container (config/crypto/ mounted at /crypto).
<% const ordererOrgs = orgs.filter(o => o.ordererGroups && o.ordererGroups.length > 0); %>
Parties:
<% ordererOrgs.forEach((org, index) => { %>
  - PartyID: <%= index + 1 %>
    CACerts:
      - /crypto/ordererOrganizations/<%= org.domain %>/msp/cacerts/ca.<%= org.domain %>-cert.pem
    TLSCACerts:
      - /crypto/ordererOrganizations/<%= org.domain %>/msp/tlscacerts/tlsca.<%= org.domain %>-cert.pem
    RouterConfig:
      TLSCert: /crypto/ordererOrganizations/<%= org.domain %>/orderers/party<%= index + 1 %>/router.<%= org.domain %>/tls/server.crt
      Host: <%= org.name.toLowerCase() %>-router
      Port: <%= 7050 + (index * 100) %>
    BatchersConfig:
      - ShardID: 1
        SignCert: /crypto/ordererOrganizations/<%= org.domain %>/orderers/party<%= index + 1 %>/batcher1.<%= org.domain %>/msp/signcerts/batcher1.<%= org.domain %>-cert.pem
        TLSCert: /crypto/ordererOrganizations/<%= org.domain %>/orderers/party<%= index + 1 %>/batcher1.<%= org.domain %>/tls/server.crt
        Host: <%= org.name.toLowerCase() %>-batcher
        Port: <%= 7051 + (index * 100) %>
    ConsenterConfig:
      SignCert: /crypto/ordererOrganizations/<%= org.domain %>/orderers/party<%= index + 1 %>/consenter.<%= org.domain %>/msp/signcerts/consenter.<%= org.domain %>-cert.pem
      TLSCert: /crypto/ordererOrganizations/<%= org.domain %>/orderers/party<%= index + 1 %>/consenter.<%= org.domain %>/tls/server.crt
      Host: <%= org.name.toLowerCase() %>-consenter
      Port: <%= 7052 + (index * 100) %>
    AssemblerConfig:
      TLSCert: /crypto/ordererOrganizations/<%= org.domain %>/orderers/party<%= index + 1 %>/assembler.<%= org.domain %>/tls/server.crt
      Host: <%= org.name.toLowerCase() %>-assembler
      Port: <%= 7053 + (index * 100) %>
<% }) %>

Consensus:
  SmartBFT:
    requestbatchmaxcount: 10000
    requestbatchmaxbytes: 10485760
    requestbatchmaxinterval: 100ms
    incomingmessagebuffersize: 200
    requestpoolsize: 500000
    requestforwardtimeout: 2s
    requestcomplaintimeout: 20s
    requestautoremovetimeout: 3m0s
    viewchangeresendinterval: 5s
    viewchangetimeout: 20s
    leaderheartbeattimeout: 1m0s
    leaderheartbeatcount: 10
    numofticksbehindbeforesyncing: 10
    collecttimeout: 1s
    requestmaxbytes: 1048576
    requestpoolsubmittimeout: 5s

Batching:
  BatchTimeouts:
    BatchCreationTimeout: 20ms # optimize for low latency
    FirstStrikeThreshold: 10s
    SecondStrikeThreshold: 10s
    AutoRemoveTimeout: 10s
  BatchSize:
    MaxMessageCount: 10000
    AbsoluteMaxBytes: 10485760
    PreferredMaxBytes: 2097152
  RequestMaxBytes: 1048576

MaxPartyID: <%= ordererOrgs.length %>
