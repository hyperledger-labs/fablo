---
server:
  endpoint: :7001
  tls:
    mode: mtls
    cert-path: /node-tls/server.crt
    key-path: /node-tls/server.key
    ca-cert-paths:
      - /org-tls-ca.pem
monitoring:
  endpoint: :2117
  tls:
    mode: none

state-db:
  db-type: sql
  sql:
    max-open-conns: 1000
    max-idle-conns: 50
    conn-max-idle-time: 1m0s
    postgres:
      dsn: host=committer-<%= org.name.toLowerCase() %>-db port=5432 user=fabricx password=fabricx dbname=fabricx sslmode=disable

identity:
  msp-dir: /msp
  bccsp:
    Default: SW
    SW:
      Security: 256
      Hash: SHA2

logging:
  logSpec: info:grpc=error
