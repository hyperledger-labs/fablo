---
OrdererOrgs:
<% orgs.filter(o => o.ordererGroups && o.ordererGroups.length > 0).forEach((org, index) => { %>
  - Name: <%= org.name %>
    Domain: <%= org.domain %>
    EnableNodeOUs: false
    CA:
      Hostname: ca
    Specs:
      - Hostname: router
        Party: party<%= index + 1 %>
        SANS:
          - <%= org.name.toLowerCase() %>-router
          - host.docker.internal
          - 0.0.0.0
          - localhost
          - 127.0.0.1
          - ::1
      - Hostname: batcher1
        Party: party<%= index + 1 %>
        SANS:
          - <%= org.name.toLowerCase() %>-batcher
          - host.docker.internal
          - 0.0.0.0
          - localhost
          - 127.0.0.1
          - ::1
      - Hostname: consenter
        Party: party<%= index + 1 %>
        SANS:
          - <%= org.name.toLowerCase() %>-consenter
          - host.docker.internal
          - 0.0.0.0
          - localhost
          - 127.0.0.1
          - ::1
      - Hostname: assembler
        Party: party<%= index + 1 %>
        SANS:
          - <%= org.name.toLowerCase() %>-assembler
          - host.docker.internal
          - 0.0.0.0
          - localhost
          - 127.0.0.1
          - ::1
    Users:
      Count: 1
<% }) %>

PeerOrgs:
<% orgs.filter(o => o.peers && o.peers.length > 0).forEach((org) => { %>
  - Name: <%= org.name %>
    Domain: <%= org.domain %>
    EnableNodeOUs: false
    CA:
      hostname: ca
      SANS:
        - 0.0.0.0
        - localhost
        - 127.0.0.1
        - ::1
    Users:
      Count: 1
      Specs:
        - Name: channel_admin
          HSM: false
    Specs:
      - Hostname: committer-sidecar
        SANS:
          - committer-<%= org.name.toLowerCase() %>-sidecar
          - host.docker.internal
          - 0.0.0.0
          - localhost
          - 127.0.0.1
          - ::1
      - Hostname: committer-coordinator
        SANS:
          - committer-<%= org.name.toLowerCase() %>-coordinator
          - host.docker.internal
          - 0.0.0.0
          - localhost
          - 127.0.0.1
          - ::1
      - Hostname: committer-validator
        SANS:
          - committer-<%= org.name.toLowerCase() %>-validator
          - host.docker.internal
          - 0.0.0.0
          - localhost
          - 127.0.0.1
          - ::1
      - Hostname: committer-verifier
        SANS:
          - committer-<%= org.name.toLowerCase() %>-verifier
          - host.docker.internal
          - 0.0.0.0
          - localhost
          - 127.0.0.1
          - ::1
      - Hostname: committer-query-service
        SANS:
          - committer-<%= org.name.toLowerCase() %>-query-service
          - host.docker.internal
          - 0.0.0.0
          - localhost
          - 127.0.0.1
          - ::1
      - Hostname: endorser
        SANS:
          - host.docker.internal
          - 0.0.0.0
          - localhost
          - 127.0.0.1
          - ::1
      - Hostname: fxconfig
        SANS:
          - host.docker.internal
          - 0.0.0.0
          - localhost
          - 127.0.0.1
          - ::1
<% }) %>
