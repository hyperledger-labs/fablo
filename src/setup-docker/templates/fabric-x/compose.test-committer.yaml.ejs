<% const ordererOrgs = orgs.filter(o => o.ordererGroups && o.ordererGroups.length > 0); %>
<% const peerOrgs = orgs.filter(o => o.peers && o.peers.length > 0); %>
name: fabric-x

# Fablo Generated Fabric-X Distributed Devnet
# This file dynamically creates separate microservices for every Orderer and Peer Organization defined in your config.

networks:
  fabric-x:
    name: fabric-x
    driver: bridge

services:
<% ordererOrgs.forEach((org, index) => { %>
  # ─── Orderer Party <%= index + 1 %> ───────────────────────────────────────────────────────
  <%= org.name.toLowerCase() %>-router:
    container_name: <%= org.name.toLowerCase() %>-router
    image: ghcr.io/hyperledger/fabric-x-orderer:1.0.0
    pull_policy: missing
    restart: unless-stopped
    user: "${UID:-1000}:${GID:-1000}"
    command: router --config=/config/node_config.yaml
    ports:
      - "7<%= index %>50:7<%= index %>50"
    volumes:
      - ./config/party<%= index + 1 %>-router.yaml:/config/node_config.yaml:ro,Z
      - ./crypto/ordererOrganizations/<%= org.domain %>/orderers/party<%= index + 1 %>/router.<%= org.domain %>/tls:/node-tls:ro,Z
      - ./crypto/ordererOrganizations/<%= org.domain %>/orderers/party<%= index + 1 %>/router.<%= org.domain %>/msp:/node-msp:ro,Z
      - ./crypto/ordererOrganizations/<%= org.domain %>/msp/tlscacerts/tlsca.<%= org.domain %>-cert.pem:/org-tls-ca.pem:ro,Z
      - ./crypto/client-tls-ca.pem:/client-tls-ca.pem:ro,Z
      - ./crypto/config-block.pb.bin:/bootstrap/genesis.block:ro,Z
      - ./data/orderers/party<%= index + 1 %>-router:/data:Z
    healthcheck:
      test: ["CMD", "curl", "-sf", "http://localhost:9443/metrics"]
      interval: 5s
      timeout: 3s
      retries: 20
      start_period: 10s
    depends_on:
      <%= org.name.toLowerCase() %>-assembler:
        condition: service_healthy
    networks:
      - fabric-x

  <%= org.name.toLowerCase() %>-batcher:
    container_name: <%= org.name.toLowerCase() %>-batcher
    image: ghcr.io/hyperledger/fabric-x-orderer:1.0.0
    pull_policy: missing
    restart: unless-stopped
    user: "${UID:-1000}:${GID:-1000}"
    command: batcher --config=/config/node_config.yaml
    ports:
      - "7<%= index %>51:7<%= index %>51"
    volumes:
      - ./config/party<%= index + 1 %>-batcher.yaml:/config/node_config.yaml:ro,Z
      - ./crypto/ordererOrganizations/<%= org.domain %>/orderers/party<%= index + 1 %>/batcher1.<%= org.domain %>/tls:/node-tls:ro,Z
      - ./crypto/ordererOrganizations/<%= org.domain %>/orderers/party<%= index + 1 %>/batcher1.<%= org.domain %>/msp:/node-msp:ro,Z
      - ./crypto/ordererOrganizations/<%= org.domain %>/msp/tlscacerts/tlsca.<%= org.domain %>-cert.pem:/org-tls-ca.pem:ro,Z
      - ./crypto/config-block.pb.bin:/bootstrap/genesis.block:ro,Z
      - ./data/orderers/party<%= index + 1 %>-batcher:/data:Z
    healthcheck:
      test: ["CMD", "curl", "-sf", "http://localhost:9443/metrics"]
      interval: 5s
      timeout: 3s
      retries: 20
      start_period: 10s
    depends_on:
<% ordererOrgs.forEach((o, i) => { %>
      <%= o.name.toLowerCase() %>-consenter:
        condition: service_healthy
<% }) %>
    networks:
      - fabric-x

  <%= org.name.toLowerCase() %>-consenter:
    container_name: <%= org.name.toLowerCase() %>-consenter
    image: ghcr.io/hyperledger/fabric-x-orderer:1.0.0
    pull_policy: missing
    restart: unless-stopped
    user: "${UID:-1000}:${GID:-1000}"
    command: consensus --config=/config/node_config.yaml
    ports:
      - "7<%= index %>52:7<%= index %>52"
    volumes:
      - ./config/party<%= index + 1 %>-consenter.yaml:/config/node_config.yaml:ro,Z
      - ./crypto/ordererOrganizations/<%= org.domain %>/orderers/party<%= index + 1 %>/consenter.<%= org.domain %>/tls:/node-tls:ro,Z
      - ./crypto/ordererOrganizations/<%= org.domain %>/orderers/party<%= index + 1 %>/consenter.<%= org.domain %>/msp:/node-msp:ro,Z
      - ./crypto/ordererOrganizations/<%= org.domain %>/msp/tlscacerts/tlsca.<%= org.domain %>-cert.pem:/org-tls-ca.pem:ro,Z
      - ./crypto/config-block.pb.bin:/bootstrap/genesis.block:ro,Z
      - ./data/orderers/party<%= index + 1 %>-consenter:/data:Z
    healthcheck:
      test: ["CMD", "curl", "-sf", "http://localhost:9443/metrics"]
      interval: 5s
      timeout: 3s
      retries: 20
      start_period: 10s
    networks:
      - fabric-x

  <%= org.name.toLowerCase() %>-assembler:
    container_name: <%= org.name.toLowerCase() %>-assembler
    image: ghcr.io/hyperledger/fabric-x-orderer:1.0.0
    pull_policy: missing
    restart: unless-stopped
    user: "${UID:-1000}:${GID:-1000}"
    command: assembler --config=/config/node_config.yaml
    ports:
      - "7<%= index %>53:7<%= index %>53"
    volumes:
      - ./config/party<%= index + 1 %>-assembler.yaml:/config/node_config.yaml:ro,Z
      - ./crypto/ordererOrganizations/<%= org.domain %>/orderers/party<%= index + 1 %>/assembler.<%= org.domain %>/tls:/node-tls:ro,Z
      - ./crypto/ordererOrganizations/<%= org.domain %>/orderers/party<%= index + 1 %>/assembler.<%= org.domain %>/msp:/node-msp:ro,Z
      - ./crypto/ordererOrganizations/<%= org.domain %>/msp/tlscacerts/tlsca.<%= org.domain %>-cert.pem:/org-tls-ca.pem:ro,Z
      - ./crypto/client-tls-ca.pem:/client-tls-ca.pem:ro,Z
      - ./crypto/config-block.pb.bin:/bootstrap/genesis.block:ro,Z
      - ./data/orderers/party<%= index + 1 %>-assembler:/data:Z
    healthcheck:
      test: ["CMD", "curl", "-sf", "http://localhost:9443/metrics"]
      interval: 5s
      timeout: 3s
      retries: 20
      start_period: 10s
    depends_on:
      <%= org.name.toLowerCase() %>-batcher:
        condition: service_healthy
    networks:
      - fabric-x

<% }) %>

<% peerOrgs.forEach((org, index) => { %>
  # ─── <%= org.name %> Committer Stack ───────────────────────────────────────────────────

  committer-<%= org.name.toLowerCase() %>-db:
    image: docker.io/library/postgres:18.3-alpine3.23
    pull_policy: missing
    restart: unless-stopped
    user: "${UID:-1000}:${GID:-1000}"
    environment:
      POSTGRES_DB: sc_db
      POSTGRES_USER: sc_user
      POSTGRES_PASSWORD: sc_secret_pwd
      PGDATA: /var/lib/postgresql/data
    volumes:
      - ./data/committer-<%= org.name.toLowerCase() %>/db:/var/lib/postgresql/data:Z
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U sc_user -d sc_db"]
      interval: 5s
      timeout: 5s
      retries: 10
    networks:
      - fabric-x

  committer-<%= org.name.toLowerCase() %>-verifier:
    image: ghcr.io/hyperledger/fabric-x-committer:1.0.3
    pull_policy: missing
    restart: unless-stopped
    user: "${UID:-1000}:${GID:-1000}"
    command: start verifier --config=/config/verifier.yaml
    volumes:
      - ./config/<%= org.name.toLowerCase() %>-verifier.yaml:/config/verifier.yaml:ro,Z
      - ./crypto/peerOrganizations/<%= org.domain %>/peers/committer-verifier.<%= org.domain %>/tls:/node-tls:ro,Z
      - ./crypto/peerOrganizations/<%= org.domain %>/msp/tlscacerts/tlsca.<%= org.domain %>-cert.pem:/org-tls-ca.pem:ro,Z
    networks:
      - fabric-x

  committer-<%= org.name.toLowerCase() %>-validator:
    image: ghcr.io/hyperledger/fabric-x-committer:1.0.3
    pull_policy: missing
    restart: unless-stopped
    user: "${UID:-1000}:${GID:-1000}"
    command: start vc --config=/config/validator.yaml
    volumes:
      - ./config/<%= org.name.toLowerCase() %>-validator.yaml:/config/validator.yaml:ro,Z
      - ./crypto/peerOrganizations/<%= org.domain %>/peers/committer-validator.<%= org.domain %>/tls:/node-tls:ro,Z
      - ./crypto/peerOrganizations/<%= org.domain %>/msp/tlscacerts/tlsca.<%= org.domain %>-cert.pem:/org-tls-ca.pem:ro,Z
    environment:
      SC_VC_DATABASE_ENDPOINTS: committer-<%= org.name.toLowerCase() %>-db:5432
    depends_on:
      committer-<%= org.name.toLowerCase() %>-db:
        condition: service_healthy
    networks:
      - fabric-x

  committer-<%= org.name.toLowerCase() %>-coordinator:
    image: ghcr.io/hyperledger/fabric-x-committer:1.0.3
    pull_policy: missing
    restart: unless-stopped
    user: "${UID:-1000}:${GID:-1000}"
    command: start coordinator --config=/config/coordinator.yaml
    volumes:
      - ./config/<%= org.name.toLowerCase() %>-coordinator.yaml:/config/coordinator.yaml:ro,Z
      - ./crypto/peerOrganizations/<%= org.domain %>/peers/committer-coordinator.<%= org.domain %>/tls:/node-tls:ro,Z
      - ./crypto/peerOrganizations/<%= org.domain %>/msp/tlscacerts/tlsca.<%= org.domain %>-cert.pem:/org-tls-ca.pem:ro,Z
    environment:
      SC_COORDINATOR_VERIFIER_ENDPOINTS: committer-<%= org.name.toLowerCase() %>-verifier:5001
      SC_COORDINATOR_VALIDATOR_COMMITTER_ENDPOINTS: committer-<%= org.name.toLowerCase() %>-validator:6001
    depends_on:
      - committer-<%= org.name.toLowerCase() %>-verifier
      - committer-<%= org.name.toLowerCase() %>-validator
    networks:
      - fabric-x

  committer-<%= org.name.toLowerCase() %>-sidecar:
    image: ghcr.io/hyperledger/fabric-x-committer:1.0.3
    pull_policy: missing
    restart: unless-stopped
    user: "${UID:-1000}:${GID:-1000}"
    command: start sidecar --config=/config/sidecar.yaml
    ports:
      - "40<%= index %>1:4001"
    volumes:
      - ./config/<%= org.name.toLowerCase() %>-sidecar.yaml:/config/sidecar.yaml:ro,Z
      - ./crypto/peerOrganizations/<%= org.domain %>/peers/committer-sidecar.<%= org.domain %>/tls:/node-tls:ro,Z
      - ./crypto/peerOrganizations/<%= org.domain %>/msp/tlscacerts/tlsca.<%= org.domain %>-cert.pem:/org-tls-ca.pem:ro,Z
      - ./crypto/peerOrganizations/<%= org.domain %>/users/User1@<%= org.domain %>/msp:/msp:ro,Z
      - ./crypto/ordererOrganizations:/orderer-cas:ro,Z
      - ./crypto/config-block.pb.bin:/bootstrap/genesis.block:ro,Z
      - ./data/committer-<%= org.name.toLowerCase() %>/sidecar-ledger:/ledger:Z
    depends_on:
      committer-<%= org.name.toLowerCase() %>-coordinator:
        condition: service_started
<% ordererOrgs.forEach((o) => { %>
      <%= o.name.toLowerCase() %>-router:
        condition: service_healthy
<% }) %>
    networks:
      - fabric-x

  committer-<%= org.name.toLowerCase() %>-query-service:
    image: ghcr.io/hyperledger/fabric-x-committer:1.0.3
    pull_policy: missing
    restart: unless-stopped
    user: "${UID:-1000}:${GID:-1000}"
    command: start query --config=/config/query-service.yaml
    ports:
      - "70<%= index %>1:7001"
    volumes:
      - ./config/<%= org.name.toLowerCase() %>-query-service.yaml:/config/query-service.yaml:ro,Z
      - ./crypto/peerOrganizations/<%= org.domain %>/peers/committer-query-service.<%= org.domain %>/tls:/node-tls:ro,Z
      - ./crypto/peerOrganizations/<%= org.domain %>/msp/tlscacerts/tlsca.<%= org.domain %>-cert.pem:/org-tls-ca.pem:ro,Z
    environment:
      SC_QUERY_DATABASE_ENDPOINTS: committer-<%= org.name.toLowerCase() %>-db:5432
    depends_on:
      committer-<%= org.name.toLowerCase() %>-db:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "curl", "-sf", "http://localhost:2117/metrics"]
      interval: 2s
      timeout: 3s
      retries: 30
      start_period: 10s
    networks:
      - fabric-x
<% }) %>
