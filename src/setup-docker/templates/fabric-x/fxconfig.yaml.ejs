<%
  const firstPeerOrg = orgs.find(o => o.peers && o.peers.length > 0);
  const firstOrdererOrg = orgs.find(o => o.ordererGroups && o.ordererGroups.length > 0);
%>logging:
  level: info

msp:
  localMspID: <%= firstPeerOrg ? firstPeerOrg.name : 'Org1' %>MSP
  configPath: /msp

orderer:
  address: <%= firstOrdererOrg.name.toLowerCase() %>-router:7050
  channel: mychannel
  tls:
    enabled: true
    clientCert: /tls/server.crt
    clientKey: /tls/server.key
    rootCerts:
      - /orderer-tls-ca.pem  # full stack: orderer CA
      - /org-tls-ca.pem      # dev: test-committer uses a peer cert

queries:
  address: committer-<%= firstPeerOrg ? firstPeerOrg.name.toLowerCase() : 'org1' %>-query-service:7001
  tls:
    enabled: true
    clientCert: /tls/server.crt
    clientKey: /tls/server.key
    rootCerts:
      - /org-tls-ca.pem

notifications:
  address: committer-<%= firstPeerOrg ? firstPeerOrg.name.toLowerCase() : 'org1' %>-sidecar:4001
  tls:
    enabled: true
    clientCert: /tls/server.crt
    clientKey: /tls/server.key
    rootCerts:
      - /org-tls-ca.pem
  connectionTimeout: 10s
  waitingTimeout: 20s
