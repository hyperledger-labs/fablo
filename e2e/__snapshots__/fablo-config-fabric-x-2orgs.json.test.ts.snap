"{
  "$schema": "https://github.com/hyperledger-labs/fablo/releases/download/2.6.0/schema.json",
  "global": {
    "fabricVersion": "3.1.0",
    "tls": true,
    "engine": "docker",
    "peerDevMode": false,
    "provider": "fabric-x"
  },
  "orgs": [
    {
      "organization": {
        "name": "Org1",
        "domain": "org1.example.com",
        "mspName": "Org1MSP"
      },
      "ca": {
        "prefix": "ca",
        "db": "sqlite"
      }
    },
    {
      "organization": {
        "name": "Org2",
        "domain": "org2.example.com",
        "mspName": "Org2MSP"
      },
      "ca": {
        "prefix": "ca",
        "db": "sqlite"
      }
    }
  ],
  "channels": [
    {
      "name": "mychannel",
      "orgs": [
        {
          "name": "Org1",
          "peers": []
        },
        {
          "name": "Org2",
          "peers": []
        }
      ]
    }
  ],
  "namespaces": [
    {
      "name": "mynamespace",
      "orgs": [
        "Org1",
        "Org2"
      ]
    },
    {
      "name": "audit_ns",
      "orgs": [
        "Org1"
      ]
    }
  ],
  "fabricX": {
    "orderer": {
      "parties": [
        {
          "organization": {
            "name": "Orderer",
            "domain": "orderer.example.com",
            "mspName": "OrdererOrdererMSP"
          }
        }
      ]
    }
  },
  "chaincodes": [],
  "hooks": {}
}
"
`;

exports[`samples/fablo-config-fabric-x-2orgs.json should create proper e2e/__tmp__/samples/fablo-config-fabric-x-2orgs.json.tmpdir/fablo-target/fabric-x/config/committer-org1-coordinator.yaml from samples/fablo-config-fabric-x-2orgs.json 1`] = `
"---
server:
  endpoint: :9001
  tls:
    mode: mtls
    cert-path: /node-tls/server.crt
    key-path: /node-tls/server.key
    ca-cert-paths:
      - /org-tls-ca.pem
monitoring:
  endpoint: :2119
  tls:
    mode: none

verifier:
  endpoints:
    - committer-org1-verifier:5001
  tls:
    mode: mtls
    cert-path: /node-tls/server.crt
    key-path: /node-tls/server.key
    ca-cert-paths:
      - /org-tls-ca.pem

validator-committer:
  endpoints:
    - committer-org1-validator:6001
  tls:
    mode: mtls
    cert-path: /node-tls/server.crt
    key-path: /node-tls/server.key
    ca-cert-paths:
      - /org-tls-ca.pem

dependency-graph:
  num-of-local-dep-constructors: 1
  waiting-txs-limit: 100000

per-channel-buffer-size-per-goroutine: 10

min-batch-keys: 1
max-batch-wait: 1ms

logging:
  logSpec: info:grpc=error
"
`;

