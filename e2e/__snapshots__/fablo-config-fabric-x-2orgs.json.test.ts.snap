exports[`samples/fablo-config-fabric-x-2orgs.json should create proper e2e/__tmp__/samples/fablo-config-fabric-x-2orgs.json.tmpdir/fablo-target/fabric-x/config/committer-org1-sidecar.yaml from samples/fablo-config-fabric-x-2orgs.json 1`] = `
"---
server:
  endpoint: :4001
  tls: &tlsConfig
    mode: mtls
    cert-path: /node-tls/server.crt
    key-path: /node-tls/server.key
    ca-cert-paths:
      - /org-tls-ca.pem
monitoring:
  endpoint: :2114
  tls: *tlsConfig

orderer:
  fault-tolerance-level: CFT
  latest-known-config-block-path: /bootstrap/genesis.block
  tls:
    mode: mtls
    cert-path: /node-tls/server.crt
    key-path: /node-tls/server.key
    common-ca-cert-paths:

      - /orderer-cas/orderer.example.com/msp/tlscacerts/tlsca.orderer.example.com-cert.pem
  identity:
    msp-id: Org1MSP
    msp-dir: /msp
    bccsp:
      Default: SW
      SW:
        Security: 256
        Hash: SHA2

committer:
  endpoint: committer-org1-coordinator:9001
  tls: *tlsConfig

ledger:
  path: /ledger
  sync-interval: 100

notification:
  max-timeout: 10m
  max-active-tx-ids: 100_000
  max-tx-ids-per-request: 1000

last-committed-block-set-interval: 5s
waiting-txs-limit: 20_000_000
channel-buffer-size: 100

logging:
  logSpec: "info"
"
`;

