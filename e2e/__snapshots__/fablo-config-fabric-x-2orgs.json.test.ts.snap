exports[`samples/fablo-config-fabric-x-2orgs.json should create proper e2e/__tmp__/samples/fablo-config-fabric-x-2orgs.json.tmpdir/fablo-target/fabric-x/docker-compose.yaml from samples/fablo-config-fabric-x-2orgs.json 1`] = `
"name: fabric-x

networks:
  fabric-x:
    name: fabric-x
    driver: bridge

volumes:
  committer-org1-db-data:
  committer-org2-db-data:

services:

  # ─── Orderer Party 1 ───────────────────────────────────────────────────────
  orderer-router:
    container_name: orderer-router
    image: ghcr.io/hyperledger/fabric-x-orderer:1.0.8
    pull_policy: missing
    restart: unless-stopped
    user: "\${FABRIC_X_UID:-1000}:\${FABRIC_X_GID:-1000}"
    command: router --config=/config/node_config.yaml
    ports:
      - "7050:7050"
    volumes:
      - ./config/orderer-router.yaml:/config/node_config.yaml:ro,Z
      - ./crypto/ordererOrganizations/orderer.example.com/orderers/party1/router.orderer.example.com/tls:/node-tls:ro,Z
      - ./crypto/ordererOrganizations/orderer.example.com/orderers/party1/router.orderer.example.com/msp:/node-msp:ro,Z
      - ./crypto/ordererOrganizations/orderer.example.com/msp/tlscacerts/tlsca.orderer.example.com-cert.pem:/org-tls-ca.pem:ro,Z
      - ./crypto/client-tls-ca.pem:/client-tls-ca.pem:ro,Z
      - ./crypto/config-block.pb.bin:/bootstrap/genesis.block:ro,Z
      - ./data/orderers/party1-router:/data:Z
    healthcheck:
      test: ["CMD", "curl", "-sf", "http://localhost:9443/metrics"]
      interval: 5s
      timeout: 3s
      retries: 20
      start_period: 10s
    depends_on:
      orderer-assembler:
        condition: service_healthy
    networks:
      - fabric-x

  orderer-batcher:
    container_name: orderer-batcher
    image: ghcr.io/hyperledger/fabric-x-orderer:1.0.8
    pull_policy: missing
    restart: unless-stopped
    user: "\${FABRIC_X_UID:-1000}:\${FABRIC_X_GID:-1000}"
    command: batcher --config=/config/node_config.yaml
    ports:
      - "7051:7051"
    volumes:
      - ./config/orderer-batcher.yaml:/config/node_config.yaml:ro,Z
      - ./crypto/ordererOrganizations/orderer.example.com/orderers/party1/batcher1.orderer.example.com/tls:/node-tls:ro,Z
      - ./crypto/ordererOrganizations/orderer.example.com/orderers/party1/batcher1.orderer.example.com/msp:/node-msp:ro,Z
      - ./crypto/ordererOrganizations/orderer.example.com/msp/tlscacerts/tlsca.orderer.example.com-cert.pem:/org-tls-ca.pem:ro,Z
      - ./crypto/config-block.pb.bin:/bootstrap/genesis.block:ro,Z
      - ./data/orderers/party1-batcher:/data:Z
    healthcheck:
      test: ["CMD", "curl", "-sf", "http://localhost:9443/metrics"]
      interval: 5s
      timeout: 3s
      retries: 20
      start_period: 10s
    depends_on:
      orderer-consenter:
        condition: service_healthy
    networks:
      - fabric-x

  orderer-consenter:
    container_name: orderer-consenter
    image: ghcr.io/hyperledger/fabric-x-orderer:1.0.8
    pull_policy: missing
    restart: unless-stopped
    user: "\${FABRIC_X_UID:-1000}:\${FABRIC_X_GID:-1000}"
    command: consensus --config=/config/node_config.yaml
    ports:
      - "7052:7052"
    volumes:
      - ./config/orderer-consenter.yaml:/config/node_config.yaml:ro,Z
      - ./crypto/ordererOrganizations/orderer.example.com/orderers/party1/consenter.orderer.example.com/tls:/node-tls:ro,Z
      - ./crypto/ordererOrganizations/orderer.example.com/orderers/party1/consenter.orderer.example.com/msp:/node-msp:ro,Z
      - ./crypto/ordererOrganizations/orderer.example.com/msp/tlscacerts/tlsca.orderer.example.com-cert.pem:/org-tls-ca.pem:ro,Z
      - ./crypto/config-block.pb.bin:/bootstrap/genesis.block:ro,Z
      - ./data/orderers/party1-consenter:/data:Z
    healthcheck:
      test: ["CMD", "curl", "-sf", "http://localhost:9443/metrics"]
      interval: 5s
      timeout: 3s
      retries: 20
      start_period: 10s
    networks:
      - fabric-x

  orderer-assembler:
    container_name: orderer-assembler
    image: ghcr.io/hyperledger/fabric-x-orderer:1.0.8
    pull_policy: missing
    restart: unless-stopped
    user: "\${FABRIC_X_UID:-1000}:\${FABRIC_X_GID:-1000}"
    command: assembler --config=/config/node_config.yaml
    ports:
      - "7053:7053"
    volumes:
      - ./config/orderer-assembler.yaml:/config/node_config.yaml:ro,Z
      - ./crypto/ordererOrganizations/orderer.example.com/orderers/party1/assembler.orderer.example.com/tls:/node-tls:ro,Z
      - ./crypto/ordererOrganizations/orderer.example.com/orderers/party1/assembler.orderer.example.com/msp:/node-msp:ro,Z
      - ./crypto/ordererOrganizations/orderer.example.com/msp/tlscacerts/tlsca.orderer.example.com-cert.pem:/org-tls-ca.pem:ro,Z
      - ./crypto/client-tls-ca.pem:/client-tls-ca.pem:ro,Z
      - ./crypto/config-block.pb.bin:/bootstrap/genesis.block:ro,Z
      - ./data/orderers/party1-assembler:/data:Z
    healthcheck:
      test: ["CMD", "curl", "-sf", "http://localhost:9443/metrics"]
      interval: 5s
      timeout: 3s
      retries: 20
      start_period: 10s
    depends_on:
      orderer-batcher:
        condition: service_healthy
    networks:
      - fabric-x

  # ─── Org1 Committer Stack ───────────────────────────────────────────────────

  committer-org1-db:
    image: docker.io/library/postgres:18.3-alpine3.23
    command: postgres -c max_connections=500
    pull_policy: missing
    restart: unless-stopped
    environment:
      POSTGRES_DB: fabricx
      POSTGRES_USER: fabricx
      POSTGRES_PASSWORD: fabricx
      PGDATA: /var/lib/postgresql/data
    volumes:
      - committer-org1-db-data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U fabricx -d fabricx"]
      interval: 5s
      timeout: 5s
      retries: 30
    networks:
      - fabric-x

  committer-org1-init-db:
    image: ghcr.io/hyperledger/fabric-x-committer:1.0.7
    user: "\${FABRIC_X_UID:-1000}:\${FABRIC_X_GID:-1000}"
    command: init-db --config=/config/validator.yaml
    volumes:
      - ./config/committer-org1-validator.yaml:/config/validator.yaml:ro,Z
    depends_on:
      committer-org1-db:
        condition: service_healthy
    networks:
      - fabric-x

  committer-org1-verifier:
    image: ghcr.io/hyperledger/fabric-x-committer:1.0.7
    pull_policy: missing
    restart: unless-stopped
    user: "\${FABRIC_X_UID:-1000}:\${FABRIC_X_GID:-1000}"
    command: start verifier --config=/config/verifier.yaml
    volumes:
      - ./config/verifier.yaml:/config/verifier.yaml:ro,Z
      - ./crypto/peerOrganizations/org1.example.com/peers/committer-verifier.org1.example.com/tls:/node-tls:ro,Z
      - ./crypto/peerOrganizations/org1.example.com/msp/tlscacerts/tlsca.org1.example.com-cert.pem:/org-tls-ca.pem:ro,Z
    healthcheck:
      test: ["CMD", "curl", "-sf", "http://localhost:2115/metrics"]
      interval: 2s
      timeout: 3s
      retries: 30
      start_period: 10s
    networks:
      - fabric-x

  committer-org1-validator:
    image: ghcr.io/hyperledger/fabric-x-committer:1.0.7
    pull_policy: missing
    restart: unless-stopped
    user: "\${FABRIC_X_UID:-1000}:\${FABRIC_X_GID:-1000}"
    command: start vc --config=/config/validator.yaml
    volumes:
      - ./config/committer-org1-validator.yaml:/config/validator.yaml:ro,Z
      - ./crypto/peerOrganizations/org1.example.com/peers/committer-validator.org1.example.com/tls:/node-tls:ro,Z
      - ./crypto/peerOrganizations/org1.example.com/msp/tlscacerts/tlsca.org1.example.com-cert.pem:/org-tls-ca.pem:ro,Z
    healthcheck:
      test: ["CMD", "curl", "-sf", "http://localhost:2116/metrics"]
      interval: 2s
      timeout: 3s
      retries: 30
      start_period: 10s
    depends_on:
      committer-org1-db:
        condition: service_healthy
      committer-org1-init-db:
        condition: service_completed_successfully
    networks:
      - fabric-x

  committer-org1-coordinator:
    image: ghcr.io/hyperledger/fabric-x-committer:1.0.7
    pull_policy: missing
    restart: unless-stopped
    user: "\${FABRIC_X_UID:-1000}:\${FABRIC_X_GID:-1000}"
    command: start coordinator --config=/config/coordinator.yaml
    volumes:
      - ./config/committer-org1-coordinator.yaml:/config/coordinator.yaml:ro,Z
      - ./crypto/peerOrganizations/org1.example.com/peers/committer-coordinator.org1.example.com/tls:/node-tls:ro,Z
      - ./crypto/peerOrganizations/org1.example.com/msp/tlscacerts/tlsca.org1.example.com-cert.pem:/org-tls-ca.pem:ro,Z
    healthcheck:
      test: ["CMD", "curl", "-sf", "http://localhost:2119/metrics"]
      interval: 2s
      timeout: 3s
      retries: 30
      start_period: 10s
    depends_on:
      committer-org1-verifier:
        condition: service_healthy
      committer-org1-validator:
        condition: service_healthy
    networks:
      - fabric-x

  committer-org1-sidecar:
    image: ghcr.io/hyperledger/fabric-x-committer:1.0.7
    pull_policy: missing
    restart: unless-stopped
    user: "\${FABRIC_X_UID:-1000}:\${FABRIC_X_GID:-1000}"
    command: start sidecar --config=/config/sidecar.yaml
    ports:
      - "4001:4001"
    volumes:
      - ./config/committer-org1-sidecar.yaml:/config/sidecar.yaml:ro,Z
      - ./crypto/peerOrganizations/org1.example.com/peers/committer-sidecar.org1.example.com/tls:/node-tls:ro,Z
      - ./crypto/peerOrganizations/org1.example.com/msp/tlscacerts/tlsca.org1.example.com-cert.pem:/org-tls-ca.pem:ro,Z
      - ./crypto/peerOrganizations/org1.example.com/users/User1@org1.example.com/msp:/msp:ro,Z
      - ./crypto/ordererOrganizations:/orderer-cas:ro,Z
      - ./crypto/config-block.pb.bin:/bootstrap/genesis.block:ro,Z
      - ./data/committer-org1/sidecar-ledger:/ledger:Z
    healthcheck:
      test: ["CMD", "curl", "-sk", "--cert", "/node-tls/server.crt", "--key", "/node-tls/server.key", "https://localhost:2114/metrics"]
      interval: 2s
      timeout: 3s
      retries: 30
      start_period: 10s
    depends_on:
      committer-org1-coordinator:
        condition: service_healthy

      orderer-router:
        condition: service_healthy

    networks:
      - fabric-x

  committer-org1-query-service:
    image: ghcr.io/hyperledger/fabric-x-committer:1.0.7
    pull_policy: missing
    restart: unless-stopped
    user: "\${FABRIC_X_UID:-1000}:\${FABRIC_X_GID:-1000}"
    command: start query --config=/config/query-service.yaml
    ports:
      - "7001:7001"
    volumes:
      - ./config/committer-org1-query-service.yaml:/config/query-service.yaml:ro,Z
      - ./crypto/peerOrganizations/org1.example.com/peers/committer-query-service.org1.example.com/tls:/node-tls:ro,Z
      - ./crypto/peerOrganizations/org1.example.com/msp/tlscacerts/tlsca.org1.example.com-cert.pem:/org-tls-ca.pem:ro,Z
    depends_on:
      committer-org1-db:
        condition: service_healthy
      committer-org1-init-db:
        condition: service_completed_successfully
    healthcheck:
      test: ["CMD", "curl", "-sf", "http://localhost:2117/metrics"]
      interval: 2s
      timeout: 3s
      retries: 30
      start_period: 10s
    networks:
      - fabric-x
  # ─── Org2 Committer Stack ───────────────────────────────────────────────────

  committer-org2-db:
    image: docker.io/library/postgres:18.3-alpine3.23
    command: postgres -c max_connections=500
    pull_policy: missing
    restart: unless-stopped
    environment:
      POSTGRES_DB: fabricx
      POSTGRES_USER: fabricx
      POSTGRES_PASSWORD: fabricx
      PGDATA: /var/lib/postgresql/data
    volumes:
      - committer-org2-db-data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U fabricx -d fabricx"]
      interval: 5s
      timeout: 5s
      retries: 30
    networks:
      - fabric-x

  committer-org2-init-db:
    image: ghcr.io/hyperledger/fabric-x-committer:1.0.7
    user: "\${FABRIC_X_UID:-1000}:\${FABRIC_X_GID:-1000}"
    command: init-db --config=/config/validator.yaml
    volumes:
      - ./config/committer-org2-validator.yaml:/config/validator.yaml:ro,Z
    depends_on:
      committer-org2-db:
        condition: service_healthy
    networks:
      - fabric-x

  committer-org2-verifier:
    image: ghcr.io/hyperledger/fabric-x-committer:1.0.7
    pull_policy: missing
    restart: unless-stopped
    user: "\${FABRIC_X_UID:-1000}:\${FABRIC_X_GID:-1000}"
    command: start verifier --config=/config/verifier.yaml
    volumes:
      - ./config/verifier.yaml:/config/verifier.yaml:ro,Z
      - ./crypto/peerOrganizations/org2.example.com/peers/committer-verifier.org2.example.com/tls:/node-tls:ro,Z
      - ./crypto/peerOrganizations/org2.example.com/msp/tlscacerts/tlsca.org2.example.com-cert.pem:/org-tls-ca.pem:ro,Z
    healthcheck:
      test: ["CMD", "curl", "-sf", "http://localhost:2115/metrics"]
      interval: 2s
      timeout: 3s
      retries: 30
      start_period: 10s
    networks:
      - fabric-x

  committer-org2-validator:
    image: ghcr.io/hyperledger/fabric-x-committer:1.0.7
    pull_policy: missing
    restart: unless-stopped
    user: "\${FABRIC_X_UID:-1000}:\${FABRIC_X_GID:-1000}"
    command: start vc --config=/config/validator.yaml
    volumes:
      - ./config/committer-org2-validator.yaml:/config/validator.yaml:ro,Z
      - ./crypto/peerOrganizations/org2.example.com/peers/committer-validator.org2.example.com/tls:/node-tls:ro,Z
      - ./crypto/peerOrganizations/org2.example.com/msp/tlscacerts/tlsca.org2.example.com-cert.pem:/org-tls-ca.pem:ro,Z
    healthcheck:
      test: ["CMD", "curl", "-sf", "http://localhost:2116/metrics"]
      interval: 2s
      timeout: 3s
      retries: 30
      start_period: 10s
    depends_on:
      committer-org2-db:
        condition: service_healthy
      committer-org2-init-db:
        condition: service_completed_successfully
    networks:
      - fabric-x

  committer-org2-coordinator:
    image: ghcr.io/hyperledger/fabric-x-committer:1.0.7
    pull_policy: missing
    restart: unless-stopped
    user: "\${FABRIC_X_UID:-1000}:\${FABRIC_X_GID:-1000}"
    command: start coordinator --config=/config/coordinator.yaml
    volumes:
      - ./config/committer-org2-coordinator.yaml:/config/coordinator.yaml:ro,Z
      - ./crypto/peerOrganizations/org2.example.com/peers/committer-coordinator.org2.example.com/tls:/node-tls:ro,Z
      - ./crypto/peerOrganizations/org2.example.com/msp/tlscacerts/tlsca.org2.example.com-cert.pem:/org-tls-ca.pem:ro,Z
    healthcheck:
      test: ["CMD", "curl", "-sf", "http://localhost:2119/metrics"]
      interval: 2s
      timeout: 3s
      retries: 30
      start_period: 10s
    depends_on:
      committer-org2-verifier:
        condition: service_healthy
      committer-org2-validator:
        condition: service_healthy
    networks:
      - fabric-x

  committer-org2-sidecar:
    image: ghcr.io/hyperledger/fabric-x-committer:1.0.7
    pull_policy: missing
    restart: unless-stopped
    user: "\${FABRIC_X_UID:-1000}:\${FABRIC_X_GID:-1000}"
    command: start sidecar --config=/config/sidecar.yaml
    ports:
      - "4002:4001"
    volumes:
      - ./config/committer-org2-sidecar.yaml:/config/sidecar.yaml:ro,Z
      - ./crypto/peerOrganizations/org2.example.com/peers/committer-sidecar.org2.example.com/tls:/node-tls:ro,Z
