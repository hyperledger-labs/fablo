"# Cert paths are absolute inside the Docker container (config/crypto/ mounted at /crypto).
Parties:

  - PartyID: 1
    CACerts:
      - /crypto/ordererOrganizations/orderer.example.com/msp/cacerts/ca.orderer.example.com-cert.pem
    TLSCACerts:
      - /crypto/ordererOrganizations/orderer.example.com/msp/tlscacerts/tlsca.orderer.example.com-cert.pem
    RouterConfig:
      SignCert: /crypto/ordererOrganizations/orderer.example.com/orderers/party1/router.orderer.example.com/msp/signcerts/router.orderer.example.com-cert.pem
      TLSCert: /crypto/ordererOrganizations/orderer.example.com/orderers/party1/router.orderer.example.com/tls/server.crt
      Host: orderer-router
      Port: 7050
    BatchersConfig:
      - ShardID: 1
        SignCert: /crypto/ordererOrganizations/orderer.example.com/orderers/party1/batcher1.orderer.example.com/msp/signcerts/batcher1.orderer.example.com-cert.pem
        TLSCert: /crypto/ordererOrganizations/orderer.example.com/orderers/party1/batcher1.orderer.example.com/tls/server.crt
        Host: orderer-batcher
        Port: 7051
    ConsenterConfig:
      SignCert: /crypto/ordererOrganizations/orderer.example.com/orderers/party1/consenter.orderer.example.com/msp/signcerts/consenter.orderer.example.com-cert.pem
      TLSCert: /crypto/ordererOrganizations/orderer.example.com/orderers/party1/consenter.orderer.example.com/tls/server.crt
      Host: orderer-consenter
      Port: 7052
    AssemblerConfig:
      SignCert: /crypto/ordererOrganizations/orderer.example.com/orderers/party1/assembler.orderer.example.com/msp/signcerts/assembler.orderer.example.com-cert.pem
      TLSCert: /crypto/ordererOrganizations/orderer.example.com/orderers/party1/assembler.orderer.example.com/tls/server.crt
      Host: orderer-assembler
      Port: 7053

Consensus:
  SmartBFT:
    requestbatchmaxcount: 10000
    requestbatchmaxbytes: 10485760
    requestbatchmaxinterval: 100ms
    incomingmessagebuffersize: 200
    requestpoolsize: 500000
    requestforwardtimeout: 2s
    requestcomplaintimeout: 20s
    requestautoremovetimeout: 3m0s
    viewchangeresendinterval: 5s
    viewchangetimeout: 20s
    leaderheartbeattimeout: 1m0s
    leaderheartbeatcount: 10
    numofticksbehindbeforesyncing: 10
    collecttimeout: 1s
    requestmaxbytes: 1048576
    requestpoolsubmittimeout: 5s

Batching:
  BatchTimeouts:
    BatchCreationTimeout: 20ms
    FirstStrikeThreshold: 10s
    SecondStrikeThreshold: 10s
    AutoRemoveTimeout: 10s
  BatchSize:
    MaxMessageCount: 10000
    AbsoluteMaxBytes: 10485760
    PreferredMaxBytes: 2097152
  RequestMaxBytes: 1048576

MaxPartyID: 1
"
`;

exports[`samples/fablo-config-fabric-x-2orgs.json should create proper e2e/__tmp__/samples/fablo-config-fabric-x-2orgs.json.tmpdir/fablo-target/fabric-x-docker.sh from samples/fablo-config-fabric-x-2orgs.json 1`] = `
"#!/usr/bin/env bash
set -eu

FABLO_NETWORK_ROOT="$(cd "$(dirname "$0")" && pwd)"
FABRIC_X_ROOT="$FABLO_NETWORK_ROOT/fabric-x"

source "$FABLO_NETWORK_ROOT/fabric-x/scripts/base-help.sh"
source "$FABLO_NETWORK_ROOT/fabric-x/scripts/base-functions.sh"

if [ "$1" = "up" ]; then
  networkUp
elif [ "$1" = "down" ]; then
  networkDown
elif [ "$1" = "reset" ]; then
  networkDown
  networkUp
elif [ "$1" = "start" ]; then
  startNetwork
elif [ "$1" = "stop" ]; then
  stopNetwork
elif [ "$1" = "namespace" ] && [ "$2" = "list" ]; then
  namespaceList "\${3:-}"
elif [ "$1" = "namespace" ] && [ "$2" = "init" ]; then
  namespaceInit "\${3:-}"
elif [ "$1" = "help" ]; then
  printHelp
elif [ "$1" = "--help" ]; then
  printHelp
else
  echo "Error: command '$1' is not supported with provider 'fabric-x'" >&2
  echo "Basic commands are: up, down, start, stop, reset" >&2
  echo "Also check: 'namespace list', 'namespace init'" >&2
  echo "Use 'help' or '--help' for more information" >&2
  exit 1
fi
"
`;

