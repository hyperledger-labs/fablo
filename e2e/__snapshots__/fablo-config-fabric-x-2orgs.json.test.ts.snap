      - ./crypto/peerOrganizations/org2.example.com/users/User1@org2.example.com/msp:/msp:ro,Z
      - ./crypto/ordererOrganizations:/orderer-cas:ro,Z
      - ./crypto/config-block.pb.bin:/bootstrap/genesis.block:ro,Z
      - ./data/committer-org2/sidecar-ledger:/ledger:Z
    healthcheck:
      test: ["CMD", "curl", "-sk", "--cert", "/node-tls/server.crt", "--key", "/node-tls/server.key", "https://localhost:2114/metrics"]
      interval: 2s
      timeout: 3s
      retries: 30
      start_period: 10s
    depends_on:
      committer-org2-coordinator:
        condition: service_healthy

      orderer-router:
        condition: service_healthy

    networks:
      - fabric-x

  committer-org2-query-service:
    image: ghcr.io/hyperledger/fabric-x-committer:1.0.7
    pull_policy: missing
    restart: unless-stopped
    user: "\${FABRIC_X_UID:-1000}:\${FABRIC_X_GID:-1000}"
    command: start query --config=/config/query-service.yaml
    ports:
      - "7002:7001"
    volumes:
      - ./config/committer-org2-query-service.yaml:/config/query-service.yaml:ro,Z
      - ./crypto/peerOrganizations/org2.example.com/peers/committer-query-service.org2.example.com/tls:/node-tls:ro,Z
      - ./crypto/peerOrganizations/org2.example.com/msp/tlscacerts/tlsca.org2.example.com-cert.pem:/org-tls-ca.pem:ro,Z
    depends_on:
      committer-org2-db:
        condition: service_healthy
      committer-org2-init-db:
        condition: service_completed_successfully
    healthcheck:
      test: ["CMD", "curl", "-sf", "http://localhost:2117/metrics"]
      interval: 2s
      timeout: 3s
      retries: 30
      start_period: 10s
    networks:
      - fabric-x
"
`;

