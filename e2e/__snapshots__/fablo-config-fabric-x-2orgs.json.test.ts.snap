exports[`samples/fablo-config-fabric-x-2orgs.json should create proper e2e/__tmp__/samples/fablo-config-fabric-x-2orgs.json.tmpdir/fablo-target/fabric-x/scripts/base-functions.sh from samples/fablo-config-fabric-x-2orgs.json 1`] = `
"#!/usr/bin/env bash

printHeadline() {
  bold=$'\\e[1m'
  end=$'\\e[0m'
  TEXT=$1
  EMOJI=$2
  printf "\${bold}============ %b %s %b ==============\${end}\\n" "\\\\$EMOJI" "$TEXT" "\\\\$EMOJI"
}

printStartSuccessInfo() {
  printHeadline "Done!! Fabric-X network is up" "U1F984"
  echo "App-level submit/query calls need a namespace."
  echo "Run './fabric-x-docker.sh namespace init' to create the configured namespace if needed."
}

TOOLS_IMAGE="\${TOOLS_IMAGE:-ghcr.io/hyperledger/fabric-x-tools:1.0.3}"
ORDERER_IMAGE="\${ORDERER_IMAGE:-ghcr.io/hyperledger/fabric-x-orderer:1.0.8}"
NETWORK="\${NETWORK:-fabric-x}"

generateArtifacts() {
  if [ -f "$FABRIC_X_ROOT/crypto/config-block.pb.bin" ] &&
    [ -f "$FABRIC_X_ROOT/crypto/shared_config.binpb" ] &&
    [ -f "$FABRIC_X_ROOT/crypto/client-tls-ca.pem" ]; then
    echo "Fabric-X crypto and config artifacts already exist, skipping generation."
    return
  fi

  if [ -d "$FABRIC_X_ROOT/crypto" ]; then
    echo "Removing incomplete Fabric-X crypto material..."
    rm -rf "$FABRIC_X_ROOT/crypto"
  fi

  mkdir -p "$FABRIC_X_ROOT/crypto"

  echo "Generating Fabric-X crypto material..."
  docker run --rm --user "$(id -u):$(id -g)" \\
    -v "$FABRIC_X_ROOT:/config" \\
    "$TOOLS_IMAGE" \\
    sh -c 'cryptogen generate --config=/config/crypto-config.yaml --output=/config/crypto \\
      && cat /config/crypto/peerOrganizations/*/msp/tlscacerts/*.pem > /config/crypto/client-tls-ca.pem'

  echo "Generating Fabric-X shared config proto..."

  docker run --rm --user "$(id -u):$(id -g)" \\
    -v "$FABRIC_X_ROOT:/config" \\
    -v "$FABRIC_X_ROOT/crypto:/crypto" \\
    --entrypoint /usr/local/bin/armageddon \\
    "$ORDERER_IMAGE" \\
    createSharedConfigProto \\
    --sharedConfigYaml=/config/shared-config.yaml \\
    --output=/config/crypto/

  echo "Generating Fabric-X genesis / config block..."
  docker run --rm --user "$(id -u):$(id -g)" \\
    -v "$FABRIC_X_ROOT:/config" \\
    "$TOOLS_IMAGE" \\
    configtxgen --channelID mychannel --profile Mychannel \\
    --outputBlock /config/crypto/config-block.pb.bin \\
    --configPath /config
}

networkUp() {
  local ledger_dirs=(
    "$FABRIC_X_ROOT/data/orderers/party1-router"
    "$FABRIC_X_ROOT/data/orderers/party1-batcher"
    "$FABRIC_X_ROOT/data/orderers/party1-consenter"
    "$FABRIC_X_ROOT/data/orderers/party1-assembler"
    "$FABRIC_X_ROOT/data/committer-org1/sidecar-ledger"
    "$FABRIC_X_ROOT/data/committer-org2/sidecar-ledger"
  )
  mkdir -p "\${ledger_dirs[@]}"

  generateArtifacts
  FABRIC_X_UID="$(id -u)" FABRIC_X_GID="$(id -g)" \\
    docker compose --project-directory "$FABRIC_X_ROOT" up -d --wait
  printStartSuccessInfo
}

networkDown() {
  (cd "$FABRIC_X_ROOT" && docker compose down -v)
  rm -rf "$FABRIC_X_ROOT/crypto" "$FABRIC_X_ROOT/data"
}

startNetwork() {
  (cd "$FABRIC_X_ROOT" && docker compose start)
}

stopNetwork() {
  (cd "$FABRIC_X_ROOT" && docker compose stop)
}

namespaceCreate() {
  local ns="$1"
  local policy="$2"
  docker run --rm --network "$NETWORK" --user "$(id -u):$(id -g)" \\
    --env "FX_NS=$ns" \\
    --env "FX_POLICY=$policy" \\
    -v "$FABRIC_X_ROOT/fxconfig-org1.yaml:/config/fxconfig.yaml:ro,Z" \\
    -v "$FABRIC_X_ROOT/crypto/peerOrganizations/org1.example.com/peers/fxconfig.org1.example.com/tls:/tls:ro,Z" \\
    -v "$FABRIC_X_ROOT/crypto/peerOrganizations/org1.example.com/users/User1@org1.example.com/msp:/msp:ro,Z" \\
    -v "$FABRIC_X_ROOT/crypto/peerOrganizations/org1.example.com/msp/tlscacerts/tlsca.org1.example.com-cert.pem:/org-tls-ca.pem:ro,Z" \\
    -v "$FABRIC_X_ROOT/crypto/ordererOrganizations/orderer.example.com/msp/tlscacerts/tlsca.orderer.example.com-cert.pem:/orderer-tls-ca.pem:ro,Z" \\
    "$TOOLS_IMAGE" \\
    sh -c 'fxconfig namespace list --config=/config/fxconfig.yaml 2>/dev/null | grep -q ") $FX_NS:" || \\
      fxconfig namespace create "$FX_NS" --policy="$FX_POLICY" --endorse --submit --wait --config=/config/fxconfig.yaml'
}

namespaceInit() {
  local target="$1"
  local found=0
  if [ -z "$target" ] || [ "$target" = "mynamespace" ]; then
    found=1
    echo "Creating namespace 'mynamespace'..."
    namespaceCreate "mynamespace" "AND('Org1MSP.member','Org2MSP.member')"
  fi
  if [ -z "$target" ] || [ "$target" = "audit_ns" ]; then
    found=1
    echo "Creating namespace 'audit_ns'..."
    namespaceCreate "audit_ns" "AND('Org1MSP.member')"
  fi
  if [ -n "$target" ] && [ "$found" = "0" ]; then
    echo "Namespace '$target' not found in fablo-config.json." >&2
    return 1
  fi
}

namespaceList() {
  local org_slug="\${1:-org1}"
  if [ "$org_slug" = "org1" ] || [ "$org_slug" = "Org1" ]; then
    docker run --rm --network "$NETWORK" --user "$(id -u):$(id -g)" \\
      -v "$FABRIC_X_ROOT/fxconfig-org1.yaml:/config/fxconfig.yaml:ro,Z" \\
      -v "$FABRIC_X_ROOT/crypto/peerOrganizations/org1.example.com/peers/fxconfig.org1.example.com/tls:/tls:ro,Z" \\
      -v "$FABRIC_X_ROOT/crypto/peerOrganizations/org1.example.com/users/User1@org1.example.com/msp:/msp:ro,Z" \\
      -v "$FABRIC_X_ROOT/crypto/peerOrganizations/org1.example.com/msp/tlscacerts/tlsca.org1.example.com-cert.pem:/org-tls-ca.pem:ro,Z" \\
      -v "$FABRIC_X_ROOT/crypto/ordererOrganizations/orderer.example.com/msp/tlscacerts/tlsca.orderer.example.com-cert.pem:/orderer-tls-ca.pem:ro,Z" \\
      "$TOOLS_IMAGE" \\
      fxconfig namespace list --config=/config/fxconfig.yaml
    return 0
  fi
  if [ "$org_slug" = "org2" ] || [ "$org_slug" = "Org2" ]; then
    docker run --rm --network "$NETWORK" --user "$(id -u):$(id -g)" \\
      -v "$FABRIC_X_ROOT/fxconfig-org2.yaml:/config/fxconfig.yaml:ro,Z" \\
      -v "$FABRIC_X_ROOT/crypto/peerOrganizations/org2.example.com/peers/fxconfig.org2.example.com/tls:/tls:ro,Z" \\
      -v "$FABRIC_X_ROOT/crypto/peerOrganizations/org2.example.com/users/User1@org2.example.com/msp:/msp:ro,Z" \\
      -v "$FABRIC_X_ROOT/crypto/peerOrganizations/org2.example.com/msp/tlscacerts/tlsca.org2.example.com-cert.pem:/org-tls-ca.pem:ro,Z" \\
      -v "$FABRIC_X_ROOT/crypto/ordererOrganizations/orderer.example.com/msp/tlscacerts/tlsca.orderer.example.com-cert.pem:/orderer-tls-ca.pem:ro,Z" \\
      "$TOOLS_IMAGE" \\
      fxconfig namespace list --config=/config/fxconfig.yaml
    return 0
  fi
  echo "Organization '$org_slug' not found in fabric-x configuration." >&2
  return 1
}
"
`;

exports[`samples/fablo-config-fabric-x-2orgs.json should create proper e2e/__tmp__/samples/fablo-config-fabric-x-2orgs.json.tmpdir/fablo-target/fabric-x/scripts/base-help.sh from samples/fablo-config-fabric-x-2orgs.json 1`] = `
"#!/usr/bin/env bash

printHelp() {
  echo "Fablo is powered by SoftwareMill"

  echo ""
  echo "usage: ./fabric-x-docker.sh <command>"
  echo ""

  echo "Network commands:"
  echo "  up             Generate artifacts and start the Fabric-X network"
  echo "  start          Start an existing Fabric-X network"
  echo "  stop           Stop the running Fabric-X network"
  echo "  down           Stop containers and remove generated crypto/data"
  echo "  reset          Run down, then up"
  echo ""

  echo "Namespace commands:"
  echo "  namespace list [org] List namespaces using the selected organization (defaults to the first org)"
  echo "  namespace init [name] Create all configured namespaces or only the named one(required for app-level"
  echo "                   submit/query, not required to bring the network up)"
  echo ""
}
"
`;

